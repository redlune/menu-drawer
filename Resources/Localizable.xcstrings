    "statusItem.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to open the drawer or ⌥-click to arrange icons"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 서랍 열기 · ⌥ 클릭으로 아이콘 배치"
