{
  "sourceLanguage": "en",
  "strings": {
    "accessibility.permissionRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that Menu Drawer is allowed in Accessibility settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 서랍의 손쉬운 사용 권한을 다시 확인해 주세요."
          }
        }
      }
    },
    "updates.check": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 확인…"
          }
        }
      }
    },
    "app.quit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Menu Drawer"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 서랍 종료"
          }
        }
      }
    },
    "drawer.collapse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Drawer Icons"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘 접기"
          }
        }
      }
    },
    "drawer.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-drag an icon to hide it"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨길 아이콘을 ⌘ 드래그하세요"
          }
        }
      }
    },
    "drawer.expand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show All Icons"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 아이콘 펼치기"
          }
        }
      }
    },
    "drawer.openAccessibilitySettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility Settings…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 설정…"
          }
        }
      }
    },
    "drawer.openAppMenu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open menu for %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 메뉴 열기"
          }
        }
      },
      "comment": "%@ is the name of another app."
    },
    "drawer.openLayout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icon Layout…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘 배치…"
          }
        }
      }
    },
    "drawer.options": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu Drawer Options"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 서랍 설정"
          }
        }
      }
    },
    "drawer.pinApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep in Menu Bar"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에 계속 표시"
          }
        }
      }
    },
    "drawer.preparingApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding %@ to the drawer…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 서랍에 넣는 중…"
          }
        }
      },
      "comment": "%@ is the name of another app."
    },
    "error.appNotRunning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn’t running."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 앱이 실행 중이 아니에요."
          }
        }
      },
      "comment": "%@ is the name of another app."
    },
    "error.hideFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS couldn’t hide the icons. Try hiding the drawer icons again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 아이콘을 숨기지 못했습니다. 서랍을 다시 접어 보세요."
          }
        }
      }
    },
    "error.installationRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Menu Drawer to Applications, then reopen it to hide icons."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 서랍을 응용 프로그램 폴더로 옮긴 뒤 다시 열면 아이콘을 숨길 수 있어요."
          }
        }
      }
    },
    "error.openAppMenu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open the menu for %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 메뉴를 열지 못했어요."
          }
        }
      },
      "comment": "%@ is the name of another app."
    },
    "error.placeApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t arrange %@. Check the menu bar or refresh the layout to try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 배치를 완료하지 못했어요. 메뉴 막대를 확인하거나 아이콘 배치에서 새로 고쳐 주세요."
          }
        }
      },
      "comment": "%@ is the name of another app."
    },
    "error.unsupportedOS": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of macOS doesn’t support hiding menu bar icons."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 macOS 버전에서 메뉴 막대 아이콘을 숨길 수 없습니다."
          }
        }
      }
    },
    "layout.accessibilityHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows ⌘-dragging in the menu bar and opening hidden apps’ menus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 바로 ⌘ 드래그하고 숨긴 앱의 메뉴를 열 수 있어요."
          }
        }
      }
    },
    "layout.autoHide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-hide after"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펼친 아이콘 자동으로 접기"
          }
        }
      }
    },
    "layout.autoHide.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끔"
          }
        }
      }
    },
    "layout.autoHide.oneMinute": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 minute"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1분"
          }
        }
      }
    },
    "layout.autoHide.tenSeconds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10 seconds"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10초"
          }
        }
      }
    },
    "layout.autoHide.thirtySeconds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30 seconds"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30초"
          }
        }
      }
    },
    "layout.dragHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag icons into the drawer to hide them, or back to the menu bar to show them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘을 서랍으로 끌어 숨기거나, 메뉴 막대로 끌어 다시 표시하세요."
          }
        }
      }
    },
    "layout.drawer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawer"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서랍"
          }
        }
      }
    },
    "layout.dropHere": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop icons here to hide them"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨길 아이콘을 여기에 놓으세요"
          }
        }
      }
    },
    "layout.menuBar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu Bar"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대"
          }
        }
      }
    },
    "layout.menuBarDragHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-drag in the menu bar"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서도 ⌘ 드래그"
          }
        }
      }
    },
    "layout.moveAppToDrawer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move %@ to the drawer"
